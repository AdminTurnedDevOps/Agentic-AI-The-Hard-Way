---
import NavList from './NavList.astro';
import { countItems, firstLabRoute, type NavGroup } from '../lib/readme-nav';
import { labCountLabel } from '../lib/site';

interface Props {
  scenario: NavGroup;
}
const { scenario } = Astro.props;
const href = firstLabRoute(scenario);
const count = countItems(scenario);
const big = count.labs + count.soon >= 6;
---
<article
  id={scenario.slug}
  class:list={['scenario', big ? 'sk' : 'sk-alt', scenario.color ? `fill-${scenario.color}` : 'is-empty']}
  data-box-href={href ?? undefined}
>
  <h3>{href ? <a href={href}>{scenario.title}</a> : scenario.title}</h3>
  {scenario.blurb && <p class="scenario-blurb">{scenario.blurb}</p>}
  {scenario.beforeYouStart.length > 0 && <NavList items={scenario.beforeYouStart} compact />}
  {scenario.items.length > 0 && <NavList items={scenario.items} ordered compact />}
  <p class="scenario-count">{labCountLabel(count)}</p>
</article>
